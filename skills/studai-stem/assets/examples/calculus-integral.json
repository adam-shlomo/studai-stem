{
  "version": 1,
  "title": "Area between two curves",
  "description": "The region between y = x and y = x² on [0, 1].",
  "course": "Calculus II",
  "assumptions": [
    "Bounds are 0 ≤ x ≤ 1.",
    "The upper curve is x; the lower curve is x²."
  ],
  "diagrams": [
    {
      "id": "fig1",
      "caption": "Integrating the upper curve and subtracting the integral of the lower curve gives 1/2 − 1/3 = 1/6.",
      "spec": {
        "v": 1,
        "kind": "function-compare",
        "title": "The bounded area",
        "x": {
          "var": "x",
          "min": 0,
          "max": 1,
          "label": "x"
        },
        "curves": [
          {
            "expr": "x",
            "label": "f",
            "color": "accent"
          },
          {
            "expr": "x^2",
            "label": "g",
            "color": "evTeal"
          }
        ],
        "regions": [
          {
            "type": "between",
            "curve": 0,
            "curve2": 1,
            "from": 0,
            "to": 1,
            "label": "Area = 1/6"
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "id": "check1",
      "diagram": "fig1",
      "kind": "integral",
      "label": "Integral of x",
      "curve": 0,
      "from": 0,
      "to": 1,
      "expected": 0.5
    },
    {
      "id": "check2",
      "diagram": "fig1",
      "kind": "integral",
      "label": "Integral of x²",
      "curve": 1,
      "from": 0,
      "to": 1,
      "expected": 0.3333333333333333
    }
  ]
}
